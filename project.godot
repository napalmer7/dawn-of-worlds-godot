; Engine configuration file.
; It's best edited using the editor UI and not directly,
; but it can also be edited by hand.

config_version=5

[application]

config/name="Dawn of Worlds: Genesis of Deities"
config/description="Faithful single-player god-game simulation inspired by John Bobek's 2005 tabletop classic Dawn of Worlds. Built for Godot 4.3+."
config/version="1.0.0"
run/main_scene="res://scenes/start_menu.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"

[autoload]

EventBus="*res://scripts/core/event_bus.gd"
RulesEngine="*res://scripts/core/rules_engine.gd"
GameManager="*res://scripts/core/game_manager.gd"
SaveManager="*res://scripts/simulation/save_manager.gd"
SessionController="*res://scripts/core/session_controller.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/resizable=true
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[rendering]

renderer/rendering_method="forward_plus"
textures/canvas_textures/default_texture_filter=1

[debug]

gdscript/warnings/unused_signal=0
